PORT=4000

# Gemini. In production every visitor sends their own key (X-Gemini-Key header), so
# set REQUIRE_USER_KEY=true there and leave GEMINI_API_KEY empty. Locally GEMINI_API_KEY
# is the fallback and is also used by the eval scripts and the eval judge.
REQUIRE_USER_KEY=false
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_JUDGE_MODEL=  (eval only; a different model spreads requests over two free-tier quotas)

# Uploads are paced to the embedding model's per-minute limits (free tier: 100 requests,
# 30,000 tokens) and wait out a per-minute 429. EMBED_PACING=false = off, as before.
# EMBED_PACING=false
# GEMINI_EMBED_RPM=100
# GEMINI_EMBED_TPM=30000

# Evidence gate: a fitted probability from the confidence signals decides instead of the
# fixed threshold. Needs the coefficients file from `node eval/fit-gate.js` (and
# CONFIDENCE_SIGNALS on); without the file the threshold still decides. Off by default.
# EVIDENCE_GATE=true
# GATE_LOW=0.3
# GATE_HIGH=0.7
# GATE_SUFFICIENCY=false   (no Gemini call in the middle zone)
# GATE_COEFFICIENTS=/path/to/gate-coefficients.json

# How the keyword and vector lists are merged: rrf (default) or convex, with alpha =
# weight of the vector score (pick it with `node eval/alpha-search.js`).
# FUSION=convex
# FUSION_ALPHA=0.5

# Cohere stays server-side (never asked from visitors)
COHERE_API_KEY=your_key_here
COHERE_RERANK_MODEL=rerank-v3.5

# Per-attempt confidence signals (top rerank score, gap, top-3 mean, BM25/vector overlap)
# are computed and logged by default. false = off, as before they existed.
# CONFIDENCE_SIGNALS=false

# Documents belong to the Gemini key that uploaded them; a key sees only its own.
# true = one library shared by every visitor, as before.
# SHARED_DOCUMENTS=true

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=anchor-dev-key
# TYPESENSE_COLLECTION=chunks

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=anchor
CORS_ORIGIN=http://localhost:3000
